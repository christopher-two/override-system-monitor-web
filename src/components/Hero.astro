---
---

<section class="hero">
	<div class="hero-content">
		<div class="hero-terminal">
			<div class="terminal-header">
				<span class="terminal-dot"></span>
				<span class="terminal-dot"></span>
				<span class="terminal-dot"></span>
				<span class="terminal-title">system_monitor.sh</span>
			</div>
			<div class="terminal-body">
				<p class="terminal-line">
					<span class="prompt">$</span>
					<span class="command">./override-monitor</span>
					<span class="cursor">█</span>
				</p>
				<p class="terminal-output">
					<span class="output-bracket">[</span>
					<img src="/logo.svg" alt="Logo" class="hero-logo" width="28" height="28" />
					<span class="output-title"> Override System Monitor v1.0</span>
					<span class="output-bracket">]</span>
				</p>
				<p class="terminal-tagline">
					<span class="tagline-prefix">&gt;</span>
					<span class="tagline-text">Monitor de sistema en tiempo real para Android</span>
				</p>
				<p class="terminal-status">
					<span class="status-ok">●</span> Sistema activo
				</p>
			</div>
		</div>
		<div class="hero-cta">
			<a href="#download" class="cta-button">
				<span class="cta-icon">↓</span>
				<span>Descargar APK</span>
			</a>
			<span class="cta-info">v1.0 • 8.2 MB • Android 11+</span>
		</div>
	</div>
</section>

<style>
	.hero {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 6rem 2rem 4rem;
	}

	.hero-content {
		text-align: center;
		max-width: 800px;
	}

	.hero-terminal {
		background: var(--bg-surface);
		border: 1px solid var(--border-subtle);
		border-radius: 8px;
		overflow: hidden;
		margin-bottom: 2.5rem;
		box-shadow: 0 0 40px rgba(0, 255, 4, 0.1);
	}

	.terminal-header {
		background: #1E1E28;
		padding: 0.75rem 1rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.terminal-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: #FF5F56;
	}

	.terminal-dot:nth-child(2) {
		background: #FFBD2E;
	}

	.terminal-dot:nth-child(3) {
		background: #27C93F;
	}

	.terminal-title {
		margin-left: auto;
		color: var(--text-secondary);
		font-size: 0.8rem;
	}

	.terminal-body {
		padding: 2rem;
		text-align: left;
	}

	.terminal-line {
		font-size: 1.1rem;
		margin-bottom: 1.5rem;
	}

	.prompt {
		color: var(--accent-green);
		margin-right: 0.75rem;
	}

	.command {
		color: var(--text-primary);
	}

	.cursor {
		color: var(--accent-green);
		animation: blink 1s infinite;
	}

	.terminal-output {
		margin-bottom: 0.75rem;
	}

	.output-bracket {
		color: var(--text-secondary);
	}

	.output-title {
		color: var(--accent-green);
		font-weight: 700;
	}

	.hero-logo {
		vertical-align: middle;
		margin-right: 0.25rem;
	}

	.terminal-tagline {
		margin-bottom: 1.5rem;
		padding-left: 1rem;
		border-left: 2px solid var(--accent-green);
	}

	.tagline-prefix {
		color: var(--accent-cyan);
		margin-right: 0.75rem;
	}

	.tagline-text {
		color: var(--text-primary);
	}

	.terminal-status {
		color: var(--text-secondary);
		font-size: 0.9rem;
	}

	.status-ok {
		color: var(--accent-green);
		margin-right: 0.5rem;
	}

	.hero-cta {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.cta-button {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		background: var(--accent-green);
		color: var(--bg-primary);
		padding: 1rem 2.5rem;
		font-size: 1.1rem;
		font-weight: 700;
		border-radius: 6px;
		transition: all 0.3s ease;
	}

	.cta-button:hover {
		background: var(--accent-cyan);
		color: var(--bg-primary);
		transform: translateY(-3px);
		box-shadow: 0 8px 30px rgba(0, 255, 4, 0.4);
	}

	.cta-icon {
		font-size: 1.3rem;
	}

	.cta-info {
		color: var(--text-secondary);
		font-size: 0.85rem;
	}

	@media (max-width: 768px) {
		.terminal-body {
			padding: 1.5rem;
		}

		.terminal-line {
			font-size: 0.95rem;
		}

		.cta-button {
			padding: 0.85rem 2rem;
			font-size: 1rem;
		}
	}
</style>