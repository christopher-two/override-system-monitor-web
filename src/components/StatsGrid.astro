---
const stats = [
	{ label: 'Batería', value: '67', unit: '%', barColor: 'green' },
	{ label: 'RAM', value: '83', unit: '%', barColor: 'cyan' },
	{ label: 'Almacenamiento', value: '54', unit: '%', barColor: 'orange' },
	{ label: 'Sensores', value: '12', unit: '', barColor: 'green', suffix: ' activos' },
];
---

<section class="stats">
	<div class="stats-header">
		<span class="stats-prefix">&gt;</span>
		<span class="stats-title">ESTADO_DEL_SISTEMA</span>
	</div>
	<div class="stats-grid">
		{stats.map((stat, index) => (
			<div class="stat-card" style={`--delay: ${index * 0.1}s`}>
				<div class="stat-label">{stat.label}</div>
				<div class="stat-value-container">
					<span class="stat-value" data-target={stat.value}>{stat.value}</span>
					<span class="stat-unit">{stat.unit}</span>
					{stat.suffix && <span class="stat-suffix">{stat.suffix}</span>}
				</div>
				<div class="stat-bar">
					<div class="stat-bar-fill" style={`--fill: ${stat.value}%`} data-fill={stat.value}></div>
				</div>
			</div>
		))}
	</div>
</section>

<style>
	.stats {
		padding: 4rem 2rem;
		max-width: 1200px;
		margin: 0 auto;
	}

	.stats-header {
		margin-bottom: 2rem;
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.stats-prefix {
		color: var(--accent-cyan);
		font-weight: 700;
	}

	.stats-title {
		color: var(--text-secondary);
		font-size: 0.85rem;
		letter-spacing: 0.15em;
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.5rem;
	}

	.stat-card {
		background: var(--bg-surface);
		border: 1px solid var(--border-subtle);
		border-radius: 8px;
		padding: 1.5rem;
		transition: all 0.3s ease;
	}

	.stat-card:hover {
		border-color: var(--accent-green);
		transform: translateY(-4px);
		box-shadow: 0 8px 30px rgba(0, 255, 4, 0.15);
	}

	.stat-label {
		color: var(--text-secondary);
		font-size: 0.85rem;
		margin-bottom: 0.75rem;
		letter-spacing: 0.05em;
	}

	.stat-value-container {
		display: flex;
		align-items: baseline;
		gap: 0.25rem;
		margin-bottom: 1rem;
	}

	.stat-value {
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--accent-green);
	}

	.stat-unit {
		font-size: 1.25rem;
		color: var(--accent-green);
	}

	.stat-suffix {
		font-size: 0.9rem;
		color: var(--text-secondary);
		margin-left: 0.25rem;
	}

	.stat-bar {
		height: 6px;
		background: var(--bg-primary);
		border-radius: 3px;
		overflow: hidden;
	}

	.stat-bar-fill {
		height: 100%;
		width: 0;
		background: var(--accent-green);
		border-radius: 3px;
		transition: width 1s ease-out;
	}

	@media (max-width: 768px) {
		.stats {
			padding: 3rem 1rem;
		}

		.stat-value {
			font-size: 2rem;
		}
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const bars = document.querySelectorAll('.stat-bar-fill');
		setTimeout(() => {
			bars.forEach(bar => {
				const fill = bar.getAttribute('data-fill');
				bar.style.width = fill + '%';
			});
		}, 500);
	});
</script>