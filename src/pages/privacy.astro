---
import { getCollection } from 'astro:content';
import DocLayout from '../components/DocLayout.astro';

const docs = await getCollection('docs');
const privacyEntry = docs.find(entry => entry.id === 'privacy.md');

if (!privacyEntry) {
	return Astro.redirect('/404');
}

const { Content } = await privacyEntry.render();
const { title, lastUpdated, description } = privacyEntry.data;
---

<DocLayout title={title} lastUpdated={lastUpdated} currentPath="/privacy">
	<Fragment slot="head">
		<title>{title} | Override System Monitor</title>
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, follow" />
	</Fragment>
	<Content />
</DocLayout>
