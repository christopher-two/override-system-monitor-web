---
import { getCollection, render } from 'astro:content';
import DocLayout from '../components/DocLayout.astro';

const docs = await getCollection('docs');
const termsEntry = docs.find(entry => entry.id === 'terms' || entry.id === 'terms.md');

if (!termsEntry) {
	return Astro.redirect('/404');
}

const { Content } = await render(termsEntry);
const { title, lastUpdated, description } = termsEntry.data;
---

<DocLayout title={title} lastUpdated={lastUpdated} currentPath="/terms">
	<Fragment slot="head">
		<title>{title} | Override System Monitor</title>
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, follow" />
	</Fragment>
	<Content />
</DocLayout>
